# Copy this file to backend/.env and fill in real values. Never commit .env.

# Django
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (used by Django)
DB_NAME=iuiu_vitaliq_db
DB_USER=iuiu_admin
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Database (used by the Postgres container in docker-compose; keep in sync with the values above)
POSTGRES_DB=iuiu_vitaliq_db
POSTGRES_USER=iuiu_admin
POSTGRES_PASSWORD=change-me
